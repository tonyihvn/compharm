{
    "name": "pharmacy-sync-server",
    "version": "1.0.0",
    "description": "Central server for pharmacy data sync - connects OpenMRS, Python pharmacy apps, and facilities",
    "main": "src/server.js",
    "type": "module",
    "scripts": {
        "start": "node src/server.js",
        "dev": "nodemon src/server.js",
        "build": "echo 'No build step required'",
        "test": "jest",
        "migrate": "sequelize-cli db:migrate",
        "migrate:undo": "sequelize-cli db:migrate:undo",
        "seed": "sequelize-cli db:seed:all"
    },
    "keywords": [
        "pharmacy",
        "openmrs",
        "sync",
        "healthcare"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "axios": "^1.6.2",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-async-errors": "^3.1.1",
        "express-rate-limit": "^7.1.0",
        "helmet": "^7.1.0",
        "joi": "^17.11.0",
        "jsonwebtoken": "^8.5.1",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.6.5",
        "postgres": "^3.4.0",
        "sequelize": "^6.35.2",
        "sequelize-cli": "^6.6.2",
        "sqlite3": "^5.1.7",
        "winston": "^3.11.0"
    },
    "devDependencies": {
        "jest": "^29.7.0",
        "nodemon": "^3.0.1",
        "supertest": "^6.3.3"
    }
}